
set TOP "tool_life_monitor_top"
set DESIGN_LIB "./stage05/work/tool_life_monitor.nlib"

puts "============================================================"
puts " STAGE 05 - TOP LEVEL SIGNAL PIN PLACEMENT"
puts "============================================================"

# ------------------------------------------------------------
# OPEN POST-CTS OPTIMIZED CHECKPOINT
# ------------------------------------------------------------

open_lib $DESIGN_LIB
open_block ${TOP}/cts_opt

puts "Current block:"
puts [get_object_name [current_block]]

# ------------------------------------------------------------
# PVT
# ------------------------------------------------------------

set_process_label  -corners [get_corners default] slow
set_process_number -corners [get_corners default] 0.99
set_voltage        -corners [get_corners default] 0.95
set_temperature    -corners [get_corners default] 125

# ------------------------------------------------------------
# SIGNAL PORT COLLECTION
#
# VDD/VSS already have PG boundary terminals generated by
# the working SAED32 power-plan flow. Do not place them here.
# ------------------------------------------------------------

set ALL_PORTS [get_ports *]
set PG_PORTS  [get_ports {VDD VSS}]
set SIGNAL_PORTS [remove_from_collection $ALL_PORTS $PG_PORTS]

puts "Total top ports:"
puts [sizeof_collection $ALL_PORTS]

puts "Signal ports to place:"
puts [sizeof_collection $SIGNAL_PORTS]

# ------------------------------------------------------------
# SIGNAL PIN CONSTRAINTS
#
# M3 horizontal / M4 vertical.
# Allow all four block sides and let ICC2 optimize locations.
# ------------------------------------------------------------

set_block_pin_constraints \
    -self \
    -allowed_layers {M3 M4} \
    -sides {1 2 3 4} \
    -pin_spacing 1

redirect -file ./stage05/reports/pin_constraints.rpt {
    report_block_pin_constraints
}

# ------------------------------------------------------------
# PLACE SIGNAL PINS
# ------------------------------------------------------------

puts "============================================================"
puts " PLACING 79 FUNCTIONAL I/O PINS"
puts "============================================================"

place_pins \
    -self \
    -ports $SIGNAL_PORTS

# ------------------------------------------------------------
# PIN-PLACEMENT VALIDATION
# ------------------------------------------------------------

check_design \
    -checks {pin_placement} \
    -log_file ./stage05/reports/check_design_pin_placement.rpt

puts "============================================================"
puts " ROUTABILITY CHECK"
puts "============================================================"

redirect -file ./stage05/reports/check_routability_after_pin_place.rpt {
    check_routability
}

# ------------------------------------------------------------
# TIMING AFTER PIN PLACEMENT
# ------------------------------------------------------------

redirect -file ./stage05/reports/setup_after_pin_place.rpt {
    report_timing -delay_type max -max_paths 20
}

redirect -file ./stage05/reports/hold_after_pin_place.rpt {
    report_timing -delay_type min -max_paths 20
}

# ------------------------------------------------------------
# SAVE
# ------------------------------------------------------------

save_block -as ${TOP}/cts_opt_pins
save_lib

puts ""
puts "============================================================"
puts " SIGNAL PIN PLACEMENT COMPLETE"
puts "============================================================"
puts ""

exit

