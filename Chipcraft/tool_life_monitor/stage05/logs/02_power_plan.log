# ------------------------------------------------------------
# 1. CORE POWER RING
#
# M9 = horizontal
# M8 = vertical
#
# Floorplan has 5um core-to-boundary offset.
# 1um ring width + 0.5um spacing gives comfortable clearance.
# ------------------------------------------------------------
create_pg_ring_pattern core_ring_pattern \
    -horizontal_layer M9 \
    -horizontal_width {1.0} \
    -horizontal_spacing {0.5} \
    -vertical_layer M8 \
    -vertical_width {1.0} \
    -vertical_spacing {0.5} \
    -corner_bridge true
