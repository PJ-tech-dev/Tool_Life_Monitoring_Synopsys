###################################################################

# Created by write_sdc on Sat Sep 26 00:28:52 2026

###################################################################
set sdc_version 2.1

set_units -time ns -resistance MOhm -capacitance fF -voltage V -current uA
create_clock [get_ports clk]  -name CLK  -period 10  -waveform {0 5}
set_clock_uncertainty -setup 0.2  [get_clocks CLK]
set_clock_uncertainty -hold 0  [get_clocks CLK]
set_input_delay -clock CLK  1  [get_ports rst_n]
set_input_delay -clock CLK  1  [get_ports {cycle_event[3]}]
set_input_delay -clock CLK  1  [get_ports {cycle_event[2]}]
